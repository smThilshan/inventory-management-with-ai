# Required
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory?schema=public
REDIS_URL=redis://localhost:6379

# Optional (defaults shown)
PORT=3001
LOW_STOCK_THRESHOLD=10
LOW_STOCK_CACHE_TTL_SECONDS=30
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
# Serve OpenAPI docs at /docs ("true" | "false")
SWAGGER_ENABLED=true

# ---- Invoicing ----
# Tax rate as a decimal fraction, up to 4 places. 0 = no tax (default); e.g. 0.05 for 5% UAE VAT
TAX_RATE=0
# ISO 4217 currency code printed on invoices
CURRENCY=AED
# Invoice due date = invoice date + this many days
INVOICE_DUE_DAYS=30
# Issuer details printed on every invoice (required)
COMPANY_NAME="Demo Trading LLC"
COMPANY_ADDRESS="Office 101, Business Bay, Dubai, United Arab Emirates"
# Where generated PDFs are stored (relative to api/; gitignored)
INVOICE_STORAGE_DIR=./storage/invoices
# IANA time zone that defines "today" for invoice dates
BUSINESS_TIMEZONE=Asia/Dubai
