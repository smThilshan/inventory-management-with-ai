{
  "name": "inventory-management",
  "private": true,
  "description": "Inventory & stock tracker: NestJS API + Next.js dashboard",
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace api",
    "db:migrate": "npm run db:migrate --workspace api",
    "db:seed": "npm run db:seed --workspace api",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
